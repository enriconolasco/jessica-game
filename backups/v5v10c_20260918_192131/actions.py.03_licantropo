def _zebum_custo_atual(player) -> int:
    return ZEBUM_FIRST_COST + ZEBUM_COST_STEP * len(player.zebum_herois)


def _zebum_heroi_em_uso_por_outro(state, my_pid, hero_id: str) -> bool:
    for p in state.players:
        if p.id == my_pid:
            continue
        if hero_id in p.zebum_herois:
            return True
    return False


def zebum_invocar_heroi(state: GameState, player_id: int, hero_id: str) -> None:
    player = get_player(state, player_id)
    zebum = next((u for u in player.units
                  if isinstance(u, Hero) and u.is_alive() and u.hero_id == "zebum"),
                 None)
    if zebum is None:
        raise ActionError("Zebum nao esta vivo.")
    if hero_id == "zebum":
        raise ActionError("Nao pode invocar Zebum via Zebum.")
    hdef = heroes.get_hero(hero_id)
    if hdef.people == "gnomos_duendes":
        raise ActionError("Nao pode invocar herois de Gnomos.")
    peoples_presentes = {p.people for p in state.players if p.people}
    if hdef.people not in peoples_presentes:
        raise ActionError("Povo nao participou da partida.")
    for other in state.players:
        if other.id == player_id:
            continue
        if other.chosen_hero_id == hero_id:
            raise ActionError("Heroi principal de outro jogador.")
    if _zebum_heroi_em_uso_por_outro(state, player_id, hero_id):
        raise ActionError("Heroi ja foi obtido por outro Zebum.")
    if hero_id in player.zebum_herois:
        raise ActionError("Ja obtido; use reinvocacao (3 Magia).")
    custo = _zebum_custo_atual(player)
    if hero_id == "seven_dwarves":
        if player.zebum_seven_dwarves:
            raise ActionError("Os 7 Anoes ja foram obtidos.")
        if player.correct_bets < custo:
            raise ActionError(f"Precisa {custo} apostas corretas.")
        player.correct_bets -= custo
        player.zebum_herois.append("seven_dwarves")
        player.zebum_seven_dwarves = True
        hdef = heroes.get_hero("dain")
        n = sum(1 for u in player.units if isinstance(u, Hero))
        unit_id = f"p{player_id}_zebum_dain_{n}"
        h = Hero(id=unit_id, owner_id=player_id, house=f"city_{player_id}",
                 life=hdef.life, life_max=hdef.life,
                 hero_id="dain", has_moved_this_turn=True, moves_this_turn=1)
        player.units.append(h)
        log(state, f"{player.name}: Zebum obteve Os 7 Anoes (Dain). Tropas bloqueadas.")
        return
    if player.correct_bets < custo:
        raise ActionError(f"Precisa {custo} apostas corretas.")
    player.correct_bets -= custo
    player.zebum_herois.append(hero_id)
    n = sum(1 for u in player.units if isinstance(u, Hero))
    unit_id = f"p{player_id}_zebum_{hero_id}_{n}"
    h = Hero(id=unit_id, owner_id=player_id, house=f"city_{player_id}",
             life=hdef.life, life_max=hdef.life,
             hero_id=hero_id, has_moved_this_turn=True, moves_this_turn=1)
    player.units.append(h)
    log(state, f"{player.name}: Zebum obteve {hdef.name} por {custo} apostas.")


def zebum_invocar_proximo_anao(state: GameState, player_id: int) -> Hero:
    player = get_player(state, player_id)
    if not player.zebum_seven_dwarves:
        raise ActionError("Zebum ainda nao obteve Os 7 Anoes.")
    alive_dwarf_ids = {u.hero_id for u in player.units
                       if isinstance(u, Hero) and u.is_alive()
                       and heroes.is_seven_dwarf(u.hero_id)}
    nxt = heroes.next_dwarf_to_summon(alive_dwarf_ids)
    if nxt is None:
        raise ActionError("Todos os 7 Anoes ja foram invocados.")
    idx = heroes.dwarf_index(nxt)
    if idx > 0:
        prev = heroes.SEVEN_DWARVES_ORDER[idx - 1]
        if prev not in alive_dwarf_ids:
            raise ActionError(f"Corrente: precisa invocar {prev} antes.")
    if player.city.magic < 2:
        raise ActionError("Precisa 2 Magia.")
    player.city.magic -= 2
    hdef = heroes.get_hero(nxt)
    n = sum(1 for u in player.units if isinstance(u, Hero))
    unit_id = f"p{player_id}_zebum_{nxt}_{n}"
    h = Hero(id=unit_id, owner_id=player_id, house=f"city_{player_id}",
             life=hdef.life, life_max=hdef.life,
             hero_id=nxt, has_moved_this_turn=True, moves_this_turn=1)
    player.units.append(h)
    log(state, f"{player.name}: Zebum invocou {hdef.name} (2 Magia).")
    return h


def zebum_reinvocar(state: GameState, player_id: int, hero_id: str) -> None:
    player = get_player(state, player_id)
    if hero_id == "seven_dwarves":
        raise ActionError("Use a opcao de Zebum+Anoes para o proximo da corrente.")
    if hero_id not in player.zebum_herois:
        raise ActionError("Heroi nao foi obtido via Zebum.")
    if any(isinstance(u, Hero) and u.is_alive() and u.hero_id == hero_id
           for u in player.units):
        raise ActionError("Heroi ja em campo.")
    if player.city.magic < ZEBUM_RESUMMON_COST:
        raise ActionError(f"Precisa {ZEBUM_RESUMMON_COST} Magia.")
    player.city.magic -= ZEBUM_RESUMMON_COST
    hdef = heroes.get_hero(hero_id)
    n = sum(1 for u in player.units if isinstance(u, Hero))
    unit_id = f"p{player_id}_zebum_re_{hero_id}_{n}"
    h = Hero(id=unit_id, owner_id=player_id, house=f"city_{player_id}",
             life=hdef.life, life_max=hdef.life,
             hero_id=hero_id, has_moved_this_turn=True, moves_this_turn=1)
    player.units.append(h)
    log(state, f"{player.name}: Zebum reinvocou {hdef.name} por {ZEBUM_RESUMMON_COST} Magia.")


