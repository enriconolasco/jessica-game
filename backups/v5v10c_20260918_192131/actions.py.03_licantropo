def aiquara_mover(state: GameState, player_id: int, enemy_unit_id: str,
                  destination: str) -> None:
    player = get_player(state, player_id)
    aiquara = next((u for u in player.units
                    if isinstance(u, Hero) and u.is_alive() and u.hero_id == "aiquara"),
                   None)
    if aiquara is None:
        raise ActionError("Aiquara nao esta viva.")
    if state.phase != Phase.DAY:
        raise ActionError("Aiquara so movimenta durante o Dia.")
    if aiquara.statuses.get("aiquara_moved_turn") == state.turn:
        raise ActionError("Aiquara ja movimentou neste turno.")
    enemy = None
    for other in state.players:
        if other.id == player_id or not other.city.is_alive():
            continue
        for u in other.units:
            if u.id == enemy_unit_id and u.is_alive() and u.house == aiquara.house:
                enemy = u
                break
        if enemy is not None:
            break
    if enemy is None:
        raise ActionError("Inimigo nao encontrado na casa de Aiquara.")
    if destination not in (CENTER, *CITY_HOUSES):
        raise ActionError("Destino invalido.")
    origin = enemy.house
    if origin == destination:
        raise ActionError("Ja esta la.")
    if origin.startswith("city_") and destination != CENTER:
        raise ActionError("De Cidade so vai para o Centro.")
    if origin == CENTER and not destination.startswith("city_"):
        raise ActionError("Do Centro so vai para Cidade.")
    enemy.house = destination
    enemy.has_moved_this_turn = True
    enemy.moves_this_turn = enemy.max_moves_this_turn
    aiquara.statuses["aiquara_moved_turn"] = state.turn
    log(state, f"{player.name}: Aiquara forcou {enemy.id} a mover para {destination}.")


def aiquara_atacar(state: GameState, player_id: int, enemy_unit_id: str,
                   target_type: str, target_id: str) -> None:
    player = get_player(state, player_id)
    aiquara = next((u for u in player.units
                    if isinstance(u, Hero) and u.is_alive() and u.hero_id == "aiquara"),
                   None)
    if aiquara is None:
        raise ActionError("Aiquara nao esta viva.")
        # v5v10 #04: só à noite
        if state.phase != Phase.NIGHT:
            raise ActionError("Aiquara so forca ataque durante a Noite.")
    if aiquara.statuses.get("aiquara_attacked_turn") == state.turn:
        raise ActionError("Aiquara ja atacou neste turno.")
    enemy = None
    enemy_owner = None
    for other in state.players:
        if other.id == player_id or not other.city.is_alive():
            continue
        for u in other.units:
            if u.id == enemy_unit_id and u.is_alive() and u.house == aiquara.house:
                enemy = u
                enemy_owner = other
                break
        if enemy is not None:
            break
    if enemy is None:
        raise ActionError("Inimigo nao encontrado na casa de Aiquara.")
    if target_type == "city" and target_id.isdigit():
        if int(target_id) == enemy.owner_id:
            raise ActionError("Nao pode atacar a propria Cidade do inimigo controlado.")
    elif target_type == "unit":
        from .combat import _find_unit
        t = _find_unit(state, target_id)
        if t is None:
            raise ActionError("Alvo nao encontrado.")
        if t.owner_id == enemy.owner_id:
            raise ActionError("Nao pode atacar aliado do inimigo controlado.")
    aiquara.statuses["aiquara_attacked_turn"] = state.turn
    from .combat import resolve_attack, Attack
    resolve_attack(state, Attack(enemy.id, target_type, target_id))
    log(state, f"{player.name}: Aiquara forcou {enemy.id} a atacar {target_type} {target_id}.")


