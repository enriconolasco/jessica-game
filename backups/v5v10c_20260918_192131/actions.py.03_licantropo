def spell_imitacao_gnomerica(state: GameState, player_id: int, choice: dict) -> None:
    player = get_player(state, player_id)
    sp_id = player.spell_copia_id
    if not sp_id:
        raise ActionError("Nenhum feitico sorteado para copiar.")
    sp = spells_mod.get_spell(sp_id)
    if sp_id == "resistencia":
