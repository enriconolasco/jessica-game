def spell_decompor(state: GameState, player_id: int, choice: dict) -> None:
    player = get_player(state, player_id)
    kind = choice.get("kind")
    if kind == "hero":
        unit_id = choice.get("unit_id")
        h = next((u for u in player.units
                  if isinstance(u, Hero) and u.is_alive() and u.id == unit_id), None)
        if h is None:
            raise ActionError("Heroi alvo nao encontrado.")
        if h.hero_id == "baoba_ba":
            player.baoba_pagamentos = 0
            player.baoba_invocado = False
        h.life = 0
        h.killed_by_player_id = player_id
        player.city.magic += 4
        log(state, f"{player.name}: Decompos heroi {h.id} (+4 Magia).")
    elif kind == "troop":
        unit_id = choice.get("unit_id")
        t = next((u for u in player.units
                  if isinstance(u, Troop) and u.is_alive() and u.id == unit_id), None)
        if t is None:
            raise ActionError("Tropa alvo nao encontrada.")
        ganho = t.life + 2
        t.life = 0
        t.killed_by_player_id = player_id
        player.city.magic += ganho
        log(state, f"{player.name}: Decompos tropa {t.id} (+{ganho} Magia).")
    elif kind == "city":
        if player.city.life <= 1:
            raise ActionError("Cidade ja com 1 de vida.")
        player.city.life -= 1
        player.city.magic += 3
        peoples.on_action_performed(state, player_id, "lose_city_life")
        log(state, f"{player.name}: Decompos muralha (-1 Vida, +3 Magia).")
    else:
        raise ActionError("Escolha invalida: hero / troop / city.")
    from .combat import _cleanup_dead
    _cleanup_dead(state)


