{
	admin off
	auto_https off
}

:{$JESSICA_PROXY_PORT} {
	bind 127.0.0.1
	@tunnel host {$JESSICA_TUNNEL_HOST}
	handle @tunnel {
		handle /updates {
			reverse_proxy 127.0.0.1:{$JESSICA_WS_PORT}
		}
		handle {
			reverse_proxy 127.0.0.1:{$JESSICA_HTTP_PORT}
		}
	}
	respond "Endereco nao permitido." 403
}
